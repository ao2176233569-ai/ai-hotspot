# AI 热点聚合站 —— 本地运行用环境变量模板
# 用法：复制为 .env（cp .env.example .env）并填入真实值，脚本会自动加载。
# 注意：.env 含密钥，请勿提交到仓库（仓库根目录 .gitignore 已忽略）。

# 主用模型（agnes 平台）
LLM_API_KEY=sk-替换为你的agnes_key
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes2.0flash

# 备用模型（可选，可与主用同一平台的不同 Key，或留空）
# FALLBACK_API_KEY=
# FALLBACK_BASE_URL=https://apihub.agnes-ai.com/v1
# FALLBACK_MODEL=agnes2.0flash
